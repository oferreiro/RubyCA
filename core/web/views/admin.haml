%h2 Welcome to RubyCA
%p Use the links above to manage your certificates.
.container
  %p
    %a{href: "/root-ca.zip"} Download CA Certificates
  %p
    %b Version: 
    #{RUBYCA_VERSION}
  %p
    %b Ruby Version:
    #{RUBY_VERSION}
