!!!
%html{ lang: 'en' }
  %head
    %meta{ charset: 'utf-8' }
    %meta{name: 'viewport', content: 'width=device-width', 'initial-scale' => '1', 'shrink-to-fit' => 'no'}
    %title= @title ? "RubyCA - #{@title}" : 'RubyCA'
    %link{ href: '/icons/favicon.ico', rel: 'icon', type: 'image/x-icon'}
    %link{ href: '/fontawesome/css/all.min.css', rel: 'stylesheet' }
    %link{ href: '/bootstrap/css/bootstrap.min.css', rel: 'stylesheet' }
    %link{ href: '/rubyca.css', rel: 'stylesheet' }

  %body
    %header
    %section
      .container
        != rodauth_flash_messages
        != yield

    %script{ src: '/jquery/jquery-4.0.0.min.js' }
    %script{ src: '/popper/popper.min.js' }
    %script{ src: '/bootstrap/js/bootstrap.min.js' }
